generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())

  senders          Sender[]
  slackIntegration SlackIntegration?
  batches          EmailBatch[]
}

model Sender {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  smtpHost  String   @default("smtp.ethereal.email")
  smtpPort  Int      @default(587)
  smtpUser  String
  smtpPass  String
  createdAt DateTime @default(now())

  batches EmailBatch[]

  @@index([userId])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamName    String?
  accessToken String?
  webhookUrl  String?
  connected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailBatch {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId    String
  sender      Sender   @relation(fields: [senderId], references: [id])
  subject     String
  body        String
  delayMs     Int
  hourlyLimit Int
  startTime   DateTime
  createdAt   DateTime @default(now())

  jobs EmailJob[]

  @@index([userId])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model EmailJob {
  id             String      @id @default(uuid())
  batchId        String
  batch          EmailBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipientEmail String
  status         EmailStatus @default(SCHEDULED)
  scheduledAt    DateTime
  sentAt         DateTime?
  error          String?
  createdAt      DateTime    @default(now())

  @@index([batchId])
  @@index([status])
  @@index([scheduledAt])
}
