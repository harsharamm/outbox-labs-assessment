# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# --- Redis (BullMQ + rate limit counters) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google OAuth (create at https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth (create at https://api.slack.com/apps) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback
# scopes requested: incoming-webhook,chat:write

# --- Worker / rate limiting (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
